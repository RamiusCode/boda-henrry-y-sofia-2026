<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== 'undefined') {
    document.addEventListener("DOMContentLoaded", () => {
      // Quien pide menos movimiento ve todo quieto
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      // ⏳ FILA DE ESPERA: si varios elementos llegan a la pantalla a la vez,
      // entran de a uno, separados por PAUSA segundos (nunca todos juntos)
      const PAUSA = 0.45;
      let proximoTurno = 0;
      function enFila(tl: gsap.core.Timeline) {
        const ahora = gsap.ticker.time;
        const espera = Math.max(0, proximoTurno - ahora);
        proximoTurno = ahora + espera + PAUSA;
        gsap.delayedCall(espera, () => tl.play());
      }

      function alAparecer(trigger: Element | string, tl: gsap.core.Timeline) {
        ScrollTrigger.create({
          trigger,
          start: "top 88%",
          onEnter: () => enFila(tl),
          onLeaveBack: () => tl.reverse(),
        });
      }

      // ✨ TEXTO DE BENDICIÓN: aparece suave, pasando de borroso a nítido
      const bendicion = gsap.timeline({ paused: true })
        .fromTo("#texto-bendicion",
          { opacity: 0, y: 24, filter: "blur(6px)" },
          { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.4, ease: "power2.out" });
      alAparecer("#texto-bendicion", bendicion);

      // 🍃 HOJAS LATERALES: entran lentas desde cada borde
      const adornos = gsap.timeline({ paused: true })
        .fromTo("#adorno-izq",
          { opacity: 0, x: -40 },
          { opacity: 1, x: 0, duration: 1.6, ease: "power3.out" })
        .fromTo("#adorno-der",
          { opacity: 0, x: 40 },
          { opacity: 1, x: 0, duration: 1.6, ease: "power3.out" }, "<");
      alAparecer("#texto-bendicion", adornos);

      // 👨‍👩‍👧 GRUPOS DE PADRES Y PADRINOS: alternando izquierda / derecha.
      // Primero el grupo, luego se abre el separador dorado, el título,
      // y los nombres aparecen uno tras otro.
      const grupos = [
        "#seccion-padres-novio",
        "#seccion-padres-novia",
        "#seccion-padrinos-religiosos",
        "#seccion-padrinos-civiles",
        "#seccion-padrinos-anillo",
        "#seccion-padrinos-decoracion",
        "#seccion-madrina-torta",
        "#seccion-padrinos-recuerdo",
      ];

      grupos.forEach((selector, i) => {
        const grupo = document.querySelector(selector);
        if (!grupo) return;
        const lado = i % 2 === 0 ? -1 : 1;
        const separador = grupo.querySelector('[aria-hidden="true"]');
        const titulo = grupo.querySelector("h2");
        const nombres = grupo.querySelectorAll("p");

        const tl = gsap.timeline({ paused: true });

        tl.fromTo(grupo,
          { opacity: 0, x: 45 * lado, filter: "blur(4px)" },
          { opacity: 1, x: 0, filter: "blur(0px)", duration: 1.2, ease: "power3.out" });

        if (separador) {
          tl.fromTo(separador,
            { scaleX: 0, opacity: 0 },
            { scaleX: 1, opacity: 1, duration: 0.9, ease: "power2.out" }, "<0.15");
        }
        if (titulo) {
          tl.fromTo(titulo,
            { opacity: 0, y: 8 },
            { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, "<0.1");
        }
        tl.fromTo(nombres,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.7, stagger: 0.14, ease: "power2.out" }, "<0.2");

        alAparecer(grupo, tl);
      });
    });
  }
</script>

